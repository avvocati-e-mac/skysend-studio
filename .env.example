# Su Mac: il programma "Avvia SkySend.command" crea questo file.
# Altrove: copialo come .env e sostituisci i valori di esempio.
SKYSEND_HOSTNAME=send.example.com
SKYSEND_WORK_DIR=./lavoro
SKYSEND_STATE_DIR=./stato
SKYSEND_UID=1000
SKYSEND_GID=1000

# Limiti facoltativi. La quota è per utente o IP ogni 24 ore.
# SKYSEND_FILE_MAX_SIZE=250MB
# SKYSEND_UPLOAD_QUOTA=1GB
